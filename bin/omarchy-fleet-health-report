#!/usr/bin/env python3
"""
Omarchy Fleet Health Report Collector
Queries live osquery telemetry (CPU, memory, kernel status, uptime) from Fleet DM.
"""

import subprocess
import json
import re
import sys
import os
import datetime
import argparse
import selectors
import time

# Hard ceilings on Fleet-controlled data. Subprocess output beyond the byte
# budget aborts collection (fail closed); host lists beyond MAX_HOSTS are
# truncated; lines longer than MAX_LINE_CHARS are skipped; the emitted report
# must fit in MAX_OUTPUT_BYTES.
MAX_HOSTS_STDOUT_BYTES = 4 * 1024 * 1024
MAX_REPORT_STDOUT_BYTES = 4 * 1024 * 1024
MAX_VERSION_STDOUT_BYTES = 64 * 1024
MAX_LINE_CHARS = 64 * 1024
MAX_HOSTS = 250
MAX_OUTPUT_BYTES = 2 * 1024 * 1024

SAFE_IP_PATTERN = re.compile(r'^[a-zA-Z0-9:][a-zA-Z0-9.:_-]{0,254}$')
SAFE_STR_PATTERN = re.compile(r'[\x00-\x1f\x7f]')

def sanitize_ip(ip_val):
    if not ip_val or not isinstance(ip_val, str):
        return "unknown"
    cleaned = ip_val.strip()
    if SAFE_IP_PATTERN.match(cleaned):
        return cleaned
    return "unknown"

def sanitize_text(val, default="unknown", max_len=255):
    if val is None:
        return default
    s = SAFE_STR_PATTERN.sub('', str(val)).strip()
    return s[:max_len] if s else default

def sanitize_int(val, default=0, lo=0, hi=2**53):
    try:
        n = int(val)
    except (ValueError, TypeError, OverflowError):
        return default
    return n if lo <= n <= hi else default

def sanitize_float(val, default=0.0, lo=0.0, hi=1e6):
    try:
        f = float(val)
    except (ValueError, TypeError, OverflowError):
        return default
    return f if lo <= f <= hi else default

class OutputLimitExceeded(Exception):
    pass

def run_bounded(argv, max_bytes, timeout):
    """Run argv without a shell, reading at most max_bytes of stdout.

    Raises OutputLimitExceeded as soon as stdout exceeds max_bytes and
    subprocess.TimeoutExpired once timeout seconds elapse; the child is
    killed in both cases. stderr is discarded rather than buffered.
    """
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + timeout
    buf = bytearray()
    try:
        with selectors.DefaultSelector() as sel:
            sel.register(proc.stdout, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(argv, timeout)
                if not sel.select(remaining):
                    continue
                chunk = os.read(proc.stdout.fileno(), min(65536, max_bytes + 1 - len(buf)))
                if not chunk:
                    break
                buf += chunk
                if len(buf) > max_bytes:
                    raise OutputLimitExceeded(f"{argv[0]} output exceeded {max_bytes} bytes")
        proc.wait(timeout=max(0.0, deadline - time.monotonic()))
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        proc.stdout.close()
    return proc.returncode, buf.decode("utf-8", errors="replace")

def extract_report_record(line):
    """Return the JSON object embedded in a `fleetctl report` output line, or None.

    Linear-time slice from the first '{' to the last '}' (a backtracking regex
    here is super-linear on hostile input).
    """
    start = line.find("{")
    end = line.rfind("}")
    if start < 0 or end <= start:
        return None
    candidate = line[start:end + 1]
    if '"host":' not in candidate or '"rows":' not in candidate:
        return None
    rec = json.loads(candidate)
    return rec if isinstance(rec, dict) else None

def disconnected_report(now_iso, server_url, error, status="Disconnected"):
    return {
        "timestamp": now_iso,
        "server_url": server_url,
        "connected": False,
        "error": error,
        "summary": {"total_nodes": 0, "online_nodes": 0, "offline_nodes": 0, "status": status},
        "nodes": []
    }

def resolve_fleet_url(override=None):
    if override:
        return override.rstrip("/")
    if os.environ.get("FLEET_SERVER_URL"):
        return os.environ["FLEET_SERVER_URL"].rstrip("/")
    
    # Try reading context from ~/.fleet/config
    fleet_cfg_path = os.path.expanduser("~/.fleet/config")
    if os.path.exists(fleet_cfg_path):
        try:
            with open(fleet_cfg_path, "r", encoding="utf-8") as f:
                content = f.read()
                # Parse address without requiring pyyaml if not installed
                addr_match = re.search(r'address:\s*["\']?([^"\'\s\n]+)["\']?', content)
                if addr_match:
                    return addr_match.group(1).rstrip("/")
        except Exception:
            pass

    return "https://localhost:1337"


#!/usr/bin/env python3
"""
Omarchy Fleet Health Report Collector
Queries live osquery telemetry (CPU, memory, kernel status, uptime) from Fleet DM.
"""

import subprocess
import json
import re
import sys
import os
import datetime
import argparse

def resolve_fleet_url(override=None):
    if override:
        return override.rstrip("/")
    if os.environ.get("FLEET_SERVER_URL"):
        return os.environ["FLEET_SERVER_URL"].rstrip("/")
    
    # Try reading context from ~/.fleet/config
    fleet_cfg_path = os.path.expanduser("~/.fleet/config")
    if os.path.exists(fleet_cfg_path):
        try:
            with open(fleet_cfg_path, "r", encoding="utf-8") as f:
                content = f.read()
                # Parse address without requiring pyyaml if not installed
                addr_match = re.search(r'address:\s*["\']?([^"\'\s\n]+)["\']?', content)
                if addr_match:
                    return addr_match.group(1).rstrip("/")
        except Exception:
            pass

    return "https://localhost:1337"


def get_fleet_data(server_url, timeout_sec=8):
    now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()

    # 1. Check if fleetctl is installed
    try:
        ver_rc, _ = run_bounded(["fleetctl", "--version"], MAX_VERSION_STDOUT_BYTES, timeout=5)
        if ver_rc != 0:
            return disconnected_report(now_iso, server_url, "fleetctl command failed or not configured")
    except FileNotFoundError:
        return disconnected_report(now_iso, server_url, "fleetctl binary not found in PATH")
    except (OutputLimitExceeded, subprocess.TimeoutExpired):
        return disconnected_report(now_iso, server_url, "fleetctl command failed or not configured")

    # 2. Query basic host information
    hosts = {}
    truncated = False
    try:
        hosts_rc, hosts_out = run_bounded(["fleetctl", "get", "hosts", "--json"], MAX_HOSTS_STDOUT_BYTES, timeout=10)
    except OutputLimitExceeded:
        return disconnected_report(now_iso, server_url, "Fleet host list exceeded size limit", status="Offline")
    except Exception:
        hosts_rc, hosts_out = 1, ""

    if hosts_rc == 0 and hosts_out.strip():
        for line in hosts_out.strip().split("\n"):
            if not line or len(line) > MAX_LINE_CHARS:
                continue
            if len(hosts) >= MAX_HOSTS:
                truncated = True
                break
            try:
                item = json.loads(line)
                spec = item.get("spec", {})
                h_name = sanitize_text(spec.get("hostname"), default="", max_len=128)
                if h_name:
                    mem_bytes = sanitize_int(spec.get("memory", 0))
                    hosts[h_name] = {
                        "id": sanitize_int(spec.get("id"), default=None),
                        "hostname": h_name,
                        "display_name": sanitize_text(spec.get("computer_name") or spec.get("display_name") or h_name, default=h_name, max_len=128),
                        "ip": sanitize_ip(spec.get("primary_ip")),
                        "status": sanitize_text(spec.get("status", "unknown"), default="unknown", max_len=32),
                        "os": sanitize_text(spec.get("os_version", "Arch Linux"), default="Arch Linux", max_len=64),
                        "osquery": sanitize_text(spec.get("osquery_version", "5.23.1"), default="5.23.1", max_len=32),
                        "disk_free_percent": sanitize_int(spec.get("percent_disk_space_available", 0), hi=100),
                        "cpu": {
                            "brand": sanitize_text(spec.get("cpu_brand") or "AMD Ryzen", default="AMD Ryzen", max_len=128),
                            "cores": sanitize_int(spec.get("cpu_logical_cores", 4), default=4, lo=1, hi=4096),
                            "load_1m": 0.0,
                            "load_5m": 0.0
                        },
                        "memory": {
                            "total_mb": round(mem_bytes / (1024 * 1024)) if mem_bytes > 0 else 4096,
                            "used_mb": 0,
                            "free_mb": 0,
                            "cached_mb": 0,
                            "percent": 0.0
                        },
                        "kernel": {
                            "version": "unknown",
                            "arguments": "",
                            "uptime_human": "",
                            "uptime_seconds": 0
                        }
                    }
            except Exception:
                pass

    if not hosts:
        return disconnected_report(now_iso, server_url, "No hosts registered or Fleet server unreachable", status="Offline")

    # 3. Query live osquery telemetry via saved report 'fleet_health_report'
    try:
        timeout_arg = f"{int(timeout_sec)}s"
        try:
            _, rep_out = run_bounded(
                ["fleetctl", "report", "--report-name", "fleet_health_report", "--labels", "All Hosts", "--timeout", timeout_arg],
                MAX_REPORT_STDOUT_BYTES, timeout=timeout_sec + 4
            )
        except OutputLimitExceeded:
            return disconnected_report(now_iso, server_url, "Fleet telemetry report exceeded size limit", status="Offline")
        if rep_out:
            for line in rep_out.split("\n"):
                if len(line) > MAX_LINE_CHARS:
                    continue
                try:
                    rec = extract_report_record(line)
                    if rec is None:
                        continue
                    h_name = rec.get("host")
                    rows = rec.get("rows", [])
                    if isinstance(h_name, str) and h_name in hosts and isinstance(rows, list) and rows and isinstance(rows[0], dict):
                        r = rows[0]
                        mem_tot = sanitize_int(r.get("memory_total", 0))
                        mem_free = sanitize_int(r.get("memory_free", 0))
                        mem_cached = sanitize_int(r.get("cached", 0))
                        mem_used = max(0, mem_tot - mem_free - mem_cached)
                        mem_pct = round((mem_used / mem_tot) * 100, 1) if mem_tot > 0 else 0
                        uptime_s = sanitize_int(r.get("uptime_seconds", 0))
                        days = uptime_s // 86400
                        hours = (uptime_s % 86400) // 3600
                        mins = (uptime_s % 3600) // 60
                        uptime_str = f"{days}d {hours}h {mins}m" if days > 0 else f"{hours}h {mins}m"

                        hosts[h_name]["cpu"]["load_1m"] = round(sanitize_float(r.get("load_1m", 0)), 2)
                        hosts[h_name]["cpu"]["load_5m"] = round(sanitize_float(r.get("load_5m", 0)), 2)
                        if r.get("cpu_brand"):
                            hosts[h_name]["cpu"]["brand"] = sanitize_text(r.get("cpu_brand"), default="AMD Ryzen", max_len=128)
                        if mem_tot > 0:
                            hosts[h_name]["memory"]["total_mb"] = round(mem_tot / (1024 * 1024))
                            hosts[h_name]["memory"]["used_mb"] = round(mem_used / (1024 * 1024))
                            hosts[h_name]["memory"]["free_mb"] = round(mem_free / (1024 * 1024))
                            hosts[h_name]["memory"]["cached_mb"] = round(mem_cached / (1024 * 1024))
                            hosts[h_name]["memory"]["percent"] = mem_pct
                        if r.get("kernel_version"):
                            hosts[h_name]["kernel"]["version"] = sanitize_text(r.get("kernel_version"), default="unknown", max_len=64)
                        if r.get("kernel_args"):
                            hosts[h_name]["kernel"]["arguments"] = sanitize_text(r.get("kernel_args"), default="", max_len=255)
                        hosts[h_name]["kernel"]["uptime_human"] = uptime_str
                        hosts[h_name]["kernel"]["uptime_seconds"] = uptime_s
                except Exception:
                    pass
    except Exception:
        pass

    node_list = list(hosts.values())
    online_count = sum(1 for n in node_list if n.get("status") == "online")
    total_count = len(node_list)
    offline_count = total_count - online_count

    loads = [n["cpu"]["load_1m"] for n in node_list if n["cpu"]["load_1m"] > 0]
    avg_load = round(sum(loads) / len(loads), 2) if loads else 0.0

    total_ram_mb = sum(n["memory"]["total_mb"] for n in node_list)
    used_ram_mb = sum(n["memory"]["used_mb"] for n in node_list)
    total_ram_gb = round(total_ram_mb / 1024, 1)
    used_ram_gb = round(used_ram_mb / 1024, 1)
    ram_pct = round((used_ram_mb / total_ram_mb) * 100, 1) if total_ram_mb > 0 else 0.0

    cluster_status = "Healthy"
    if offline_count > 0:
        cluster_status = "Warning" if online_count > 0 else "Degraded"

    kernel_versions = list({n["kernel"]["version"] for n in node_list if n["kernel"]["version"] != "unknown"})
    kernel_display = kernel_versions[0] if kernel_versions else "Linux"

    return {
        "timestamp": now_iso,
        "server_url": server_url,
        "connected": True,
        "summary": {
            "total_nodes": total_count,
            "online_nodes": online_count,
            "offline_nodes": offline_count,
            "avg_load_1m": avg_load,
            "total_ram_gb": total_ram_gb,
            "used_ram_gb": used_ram_gb,
            "ram_percent": ram_pct,
            "kernel_version": kernel_display,
            "status": cluster_status
        },
        "nodes": node_list,
        "truncated": truncated
    }

def render_report(report):
    out = json.dumps(report, indent=2)
    if len(out.encode("utf-8")) > MAX_OUTPUT_BYTES:
        fallback = disconnected_report(report.get("timestamp"), report.get("server_url"), "Fleet report exceeded size limit", status="Offline")
        out = json.dumps(fallback, indent=2)
    return out

def main():
    parser = argparse.ArgumentParser(description="Omarchy Fleet DM Health Report")
    parser.add_argument("--server-url", help="Fleet DM server URL override")
    parser.add_argument("--demo", "--mock", action="store_true", help="Output sanitized demo telemetry for testing or previews")
    parser.add_argument("--timeout", type=int, default=8, help="Timeout in seconds for live query")
    args = parser.parse_args()

    server_url = resolve_fleet_url(args.server_url)

    if args.demo or os.path.exists(os.path.expanduser("~/.config/omarchy/fleet-demo")):
        report = get_demo_data(args.server_url)
    else:
        report = get_fleet_data(server_url, timeout_sec=args.timeout)

    print(render_report(report))

if __name__ == "__main__":
    main()

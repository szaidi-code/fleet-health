{
  "schemaVersion": 1,
  "id": "fleet.health",
  "name": "Fleet Health",
  "version": "1.0.0",
  "author": "szaidi-code",
  "license": "MIT",
  "description": "Fleet DM cluster telemetry, osquery health reports, and node monitoring in the Omarchy bar.",
  "repository": "https://github.com/szaidi-code/fleet-health",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Fleet DM",
    "description": "Monitor Fleet DM host health, online nodes, and cluster telemetry.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15,
      "serverUrl": "https://localhost:1337"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "serverUrl",
        "type": "string",
        "label": "Fleet DM server URL",
        "defaultValue": "https://localhost:1337"
      }
    ]
  }
}
